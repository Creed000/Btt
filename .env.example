# Telegram
BOT_TOKEN=PASTE_NEW_BOT_TOKEN_HERE

# Database
# Railway обычно сам создаёт DATABASE_URL.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE

# Application
APP_TIMEZONE=Asia/Bishkek
DEBUG=false

# SaaS platform access
OWNER_TELEGRAM_ID=123456789
ADMIN_TELEGRAM_IDS=

# Optional
REDIS_URL=
SECRET_KEY=replace-with-a-random-string-at-least-16-characters
