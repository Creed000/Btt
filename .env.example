# Telegram
BOT_TOKEN=

# Database
# Railway PostgreSQL example:
# postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# Optional Redis
REDIS_URL=

# Application security
# Use a long random value in production.
SECRET_KEY=

# App
DEBUG=false
APP_TIMEZONE=Asia/Bishkek

# Platform owner / admins
# OWNER_TELEGRAM_ID=123456789
OWNER_TELEGRAM_ID=

# Comma-separated Telegram IDs:
# ADMIN_TELEGRAM_IDS=123456789,987654321
ADMIN_TELEGRAM_IDS=
